rules_version = '2';

// Model i decyzje: docs/ROADMAP.md → „Decyzje” i „Model danych”.
// Testy: npm run test:rules (emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid);
    }

    // Administrator ogólny — jedno konto, admin każdego mieszkania (także
    // przed dołączeniem, np. migracja pierwszego mieszkania). Zmiana adresu
    // także w src/lib/householdSetup.ts (SUPER_ADMIN_EMAIL).
    function isSuperAdmin() {
      return hasAccount()
        && request.auth.token.email == 'stasiron9102@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // isSuperAdmin() najpierw — lista mieszkań (query) przechodzi bez exists()
    function isMember(hid) {
      return signedIn() && (isSuperAdmin() || exists(memberPath(hid)));
    }

    function isAdmin(hid) {
      return signedIn()
        && (isSuperAdmin()
          || (exists(memberPath(hid)) && get(memberPath(hid)).data.role == 'admin'));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Role (src/config/roles.ts): admin, member, guest (tylko podgląd części
    // aplikacji), device (wspólny tablet: odhacza, dopisuje do kuchni).
    // Wołać po isMember(hid) — get() własnego wpisu.
    function roleOf(hid) {
      return isSuperAdmin() ? 'admin' : get(memberPath(hid)).data.get('role', 'member');
    }

    // Każdy poza gościem
    function canWrite(hid) {
      return isMember(hid) && roleOf(hid) != 'guest';
    }

    function isDevice(hid) {
      return roleOf(hid) == 'device';
    }

    // Gość czyta tylko kuchnię, ogłoszenia i Poradnik
    function guestReadable(collection) {
      return collection in [
        'shopping', 'fridge', 'products', 'announcements', 'guides',
        'guideTabs', 'guideEntries', 'laundry', 'recipePlans'
      ];
    }

    function canRead(hid, collection) {
      return isMember(hid) && (roleOf(hid) != 'guest' || guestReadable(collection));
    }

    // Ograniczniki częstotliwości (anty-spam, ochrona limitu bazy): przy
    // zgłoszeniu błędu albo założeniu mieszkania klient w tym samym batchu
    // wpisuje rateLimits/{uid}.{key} = serverTimestamp(). Reguła wymaga tego
    // znacznika i odstępu od poprzedniego. Wpisu nie da się usunąć ani
    // ustawić na inny czas niż „teraz”.
    function rateLimitPath() {
      return /databases/$(database)/documents/rateLimits/$(request.auth.uid);
    }

    function rateOk(key, seconds) {
      return existsAfter(rateLimitPath())
        && getAfter(rateLimitPath()).data.get(key, null) == request.time
        && (!exists(rateLimitPath())
          || get(rateLimitPath()).data.get(key, null) == null
          || get(rateLimitPath()).data.get(key, null)
            < request.time - duration.value(seconds, 's'));
    }

    match /rateLimits/{uid} {
      function stampOk(key) {
        return !(key in request.resource.data)
          || request.resource.data[key] == request.time
          || (resource != null && resource.data.get(key, null) == request.resource.data[key]);
      }

      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['bugReport', 'household'])
        && stampOk('bugReport') && stampOk('household');
    }

    match /users/{userId} {
      // E-mail w dokumencie konta zgodny z tokenem — serwer szuka po nim
      // administratora ogólnego (push zgłoszeń), więc nie da się go podrobić
      function emailOk() {
        return !('email' in request.resource.data)
          || request.resource.data.email == null
          || request.resource.data.email == request.auth.token.get('email', null);
      }

      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && emailOk();

      match /memberships/{hid} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Urządzenia z włączonymi powiadomieniami (Web Push) — tylko właściciel;
      // serwer czyta je kontem serwisowym
      match /pushSubscriptions/{subId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Prywatna lodówka, instrukcje… — tylko z kontem (decyzja 1)
      match /private/{document=**} {
        allow read, write: if hasAccount() && request.auth.uid == userId;
      }
    }

    // Zgłoszenia błędów — wysyła każdy zalogowany (także tablet), czyta
    // i obsługuje tylko administrator ogólny
    match /bugReports/{reportId} {
      allow create: if signedIn() && rateOk('bugReport', 60)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.keys().hasOnly([
          'description', 'status', 'createdAt', 'uid', 'email', 'anonymous',
          'householdId', 'householdName', 'role', 'path', 'search', 'tab',
          'selector', 'elementText', 'heading', 'x', 'y', 'viewport',
          'scrollY', 'appVersion', 'appCommit', 'userAgent'
        ]);
      allow read, update, delete: if isSuperAdmin();
    }

    // Ustawienia całej aplikacji (src/lib/globalConfig.ts)
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /invites/{code} {
      // get po znanym kodzie tak, list nie — kodów nie da się wyliczyć
      allow get: if signedIn();
      allow create: if isAdmin(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAdmin(resource.data.householdId);
    }

    match /households/{hid} {
      allow read: if isMember(hid);
      allow create: if hasAccount()
        && request.resource.data.ownerId == request.auth.uid
        && rateOk('household', 60);
      // Przekazanie własności: twórca (albo administrator ogólny) oddaje
      // mieszkanie innemu administratorowi
      function ownerChangeOk() {
        let next = request.resource.data.ownerId;
        return (isSuperAdmin() || resource.data.ownerId == request.auth.uid)
          && exists(/databases/$(database)/documents/households/$(hid)/members/$(next))
          && get(/databases/$(database)/documents/households/$(hid)/members/$(next)).data.role == 'admin';
      }

      // PANIC (goście) włącza każdy domownik — tylko to jedno pole.
      // Kod zaproszenia nie mieszka już w tym dokumencie (czytają go goście) —
      // dozwolone jest tylko jego usunięcie (przeniesienie do admin/invite).
      allow update: if (isAdmin(hid)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
            || ownerChangeOk())
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCode'])
            || !('inviteCode' in request.resource.data)))
        || (canWrite(hid) && changedOnly(['panic']));
      // Usuwa twórca albo administrator ogólny
      allow delete: if isSuperAdmin() || resource.data.ownerId == request.auth.uid;

      // Kod zaproszenia — tylko administratorzy (goście i urządzenia go nie
      // widzą, więc nie dołączą ponownie jako domownik)
      match /admin/{docId} {
        allow read, write: if isAdmin(hid);
      }

      match /members/{uid} {
        allow read: if isMember(hid);

        // Nowy wpis: tylko znane pola, a dane konta zgodne z tokenem —
        // nikt nie dołączy z cudzym e-mailem (admin łączy konta po nim)
        function newMemberOk() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'uid', 'role', 'profileId', 'anonymous', 'displayName', 'email',
              'provider', 'joinedAt', 'inviteCode'
            ])
            && (!('email' in data) || data.email == null
              || data.email == request.auth.token.get('email', null))
            && (!('anonymous' in data)
              || data.anonymous == (request.auth.token.firebase.sign_in_provider == 'anonymous'));
        }

        // Konto z e-mailem dołącza kodem dopiero po potwierdzeniu adresu.
        // Urządzenie bez konta (np. wspólny tablet) — bez zmian.
        function verifiedOrDevice() {
          return request.auth.token.firebase.sign_in_provider == 'anonymous'
            || request.auth.token.get('email_verified', false) == true;
        }

        allow create: if signedIn() && request.auth.uid == uid && newMemberOk() && (
          // Twórca mieszkania — w tym samym batchu co dokument mieszkania
          (request.resource.data.role == 'admin'
            && getAfter(householdPath(hid)).data.ownerId == request.auth.uid)
          // Administrator ogólny dopisuje się do dowolnego mieszkania
          || (request.resource.data.role == 'admin' && isSuperAdmin())
          // Dołączenie kodem zaproszenia: konto jako domownik, bez konta
          // jako urządzenie (wspólny tablet)
          || (((request.resource.data.role == 'member' && hasAccount())
              || (request.resource.data.role == 'device' && !hasAccount()))
            && verifiedOrDevice()
            && request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == hid)
        );

        // Własny wpis: profil + dane konta, ale tylko zgodne z tokenem —
        // nikt nie wpisze sobie cudzego e-maila (admin łączy konta po nim)
        function memberChanged() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        function tokenProvider() {
          return request.auth.token.firebase.sign_in_provider;
        }

        // Link z maila: token mówi „emailLink”, a konto (providerData) —
        // „password”. Oba to to samo konto e-mail.
        function providerMatches(provider) {
          return provider == tokenProvider()
            || (provider == 'password' && tokenProvider() == 'emailLink');
        }

        // Swój profil wybierasz sam tylko, gdy nie masz żadnego (albo go
        // odpinasz) — przejęcie cudzego profilu zmienia już administrator
        function profileChangeOk() {
          return !memberChanged().hasAny(['profileId'])
            || resource.data.get('profileId', null) == null
            || request.resource.data.profileId == null;
        }

        function selfUpdateOk() {
          return memberChanged().hasOnly([
              'profileId', 'displayName', 'email', 'anonymous', 'provider'
            ])
            && profileChangeOk()
            && (!memberChanged().hasAny(['email'])
              || request.resource.data.email == request.auth.token.get('email', null))
            && (!memberChanged().hasAny(['anonymous'])
              || request.resource.data.anonymous == (tokenProvider() == 'anonymous'))
            && (!memberChanged().hasAny(['provider'])
              || providerMatches(request.resource.data.provider));
        }

        function householdOwner() {
          return get(householdPath(hid)).data.ownerId;
        }

        // Role nadaje tylko twórca mieszkania albo administrator ogólny
        function canManageRoles() {
          return isSuperAdmin() || householdOwner() == request.auth.uid;
        }

        // Twórcy nie odbierze roli ani nie usunie inny administrator
        function touchesOwner() {
          return uid == householdOwner()
            && request.auth.uid != uid
            && !isSuperAdmin();
        }

        allow update: if (isAdmin(hid)
            && (!memberChanged().hasAny(['role'])
              || (canManageRoles()
                && request.resource.data.role in ['admin', 'member', 'guest', 'device']))
            && !touchesOwner())
          || (signedIn() && request.auth.uid == uid && selfUpdateOk());

        // Admin usuwa (poza twórcą), każdy może wyjść sam — twórca dopiero
        // po przekazaniu mieszkania (albo razem z usunięciem mieszkania)
        function ownerLeaving() {
          return uid == request.auth.uid
            && existsAfter(householdPath(hid))
            && getAfter(householdPath(hid)).data.ownerId == uid;
        }

        allow delete: if ((isAdmin(hid) && !touchesOwner())
          || (signedIn() && request.auth.uid == uid))
          && (isSuperAdmin() || !ownerLeaving());
      }

      // Domownicy (też bez konta) — lista osób mieszkania
      match /profiles/{profileId} {
        allow read: if isMember(hid);
        allow create, delete: if isAdmin(hid);
        allow update: if isAdmin(hid)
          || (canWrite(hid) && changedOnly(['heavyDay']));
      }

      match /assets/{assetId} {
        allow read: if isMember(hid);
        allow write: if isAdmin(hid);
      }

      // Historia wykonań (statystyki) — tylko dopisywana: wpis dodaje każdy
      // domownik (także tablet), zmienić się go nie da, usuwa administrator.
      // Czytanie wg statsVisibility mieszkania: all — domownicy, own — tylko
      // wpisy własnego profilu (zapytanie po `by`), admins — tylko admin.
      // Gość i urządzenie statystyk nie widzą.
      match /completions/{completionId} {
        function statsMode() {
          return get(householdPath(hid)).data.get('statsVisibility', 'all');
        }

        function ownCompletion() {
          return resource.data.by != null
            && resource.data.by == get(memberPath(hid)).data.get('profileId', null);
        }

        allow read: if isAdmin(hid)
          || (isMember(hid) && roleOf(hid) == 'member'
            && (statsMode() == 'all' || (statsMode() == 'own' && ownCompletion())));
        allow create: if canWrite(hid)
          && request.resource.data.createdBy == request.auth.uid;
        allow delete: if isAdmin(hid);
      }

      // Prywatne obowiązki / zadania / todo / zakupy / lodówka / poradnik —
      // tylko autor (z kontem). Nawet administrator ogólny ich nie widzi.
      match /private/{ownerUid}/{collection}/{itemId} {
        allow read, write: if hasAccount()
          && request.auth.uid == ownerUid
          && collection in [
            'chores', 'zadania', 'todos', 'shopping', 'fridge', 'guides',
            'guideEntries', 'products', 'laundry', 'recipePlans'
          ]
          && exists(memberPath(hid));
      }

      // Przepisy — zawsze czyjeś (konto). Widzi autor, wszyscy domownicy
      // przy share == 'all' albo konta z mapy sharedWith. Zmienia tylko autor.
      match /recipes/{recipeId} {
        function recipeOwner() {
          return hasAccount() && resource.data.createdBy == request.auth.uid;
        }

        function validShare() {
          return request.resource.data.share in ['private', 'all', 'people']
            && request.resource.data.sharedWith is map
            && (request.resource.data.share == 'people'
              || request.resource.data.sharedWith.size() == 0);
        }

        allow read: if isMember(hid) && (
          resource.data.share == 'all'
          || (signedIn() && resource.data.createdBy == request.auth.uid)
          || (signedIn()
            && resource.data.sharedWith.get(request.auth.uid, false) == true)
        );

        allow create: if hasAccount() && exists(memberPath(hid)) && canWrite(hid)
          && request.resource.data.createdBy == request.auth.uid
          && validShare();

        allow update: if recipeOwner() && exists(memberPath(hid)) && canWrite(hid)
          && request.resource.data.createdBy == request.auth.uid
          && validShare();

        allow delete: if recipeOwner();
      }

      // Elementy z przyciskiem „Zablokuj edycję” (decyzja 3a)
      match /{collection}/{itemId} {
        function lockable() {
          return collection in [
            'chores', 'zadania', 'todos', 'todoFolders',
            'shopping', 'laundry', 'guestPlans', 'fridge', 'guides',
            'guideTabs', 'guideEntries', 'bills', 'purchases', 'products',
            'announcements', 'absences', 'recipePlans'
          ];
        }

        function isCreator() {
          return resource.data.createdBy == request.auth.uid;
        }

        function wasLocked() {
          return resource.data.get('locked', false) == true;
        }

        function willBeLocked() {
          return request.resource.data.get('locked', false) == true;
        }

        function canEdit() {
          return !wasLocked() || isCreator() || isAdmin(hid);
        }

        // Odhaczanie zablokowanego elementu — każdy domownik
        function progressOnly() {
          // rotationTurn — „na zmianę”: odhaczenie przesuwa turę
          // amount — zużycie z lodówki po ugotowaniu przepisu
          // settled, confirmed, payments, refundRequestedAt — rozliczenia rachunków i zakupów
          // stock, stockAmount, lastBoughtAt — zużycie i uzupełnienie zapasów
          return changedOnly([
            'lastCompleted', 'lastCompletedBy', 'done', 'completedBy', 'checked',
            'rotationTurn', 'amount', 'settled', 'stock', 'stockAmount',
            'lastBoughtAt', 'refundRequestedAt', 'issueStatus', 'confirmed', 'payments'
          ])
            // amount = zużycie w kuchni; kwoty rachunku tak nie zmienisz
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount'])
              || collection in ['fridge', 'shopping', 'products']);
        }

        function lockChangeAllowed() {
          return wasLocked() == willBeLocked()
            || (hasAccount() && (isCreator() || isAdmin(hid)));
        }

        // Urządzenie (tablet) dopisuje i zdejmuje tylko pozycje kuchni
        function deviceKitchen() {
          return collection in ['shopping', 'fridge', 'products', 'recipePlans'];
        }

        allow read: if lockable() && canRead(hid, collection);

        allow create: if lockable() && canWrite(hid)
          && (!isDevice(hid) || deviceKitchen())
          && request.resource.data.createdBy == request.auth.uid
          && (!willBeLocked() || hasAccount());

        // Urządzenie poza kuchnią zmienia tylko pola odhaczania i zużycia
        allow update: if lockable() && canWrite(hid)
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && lockChangeAllowed()
          && ((canEdit() && (!isDevice(hid) || deviceKitchen())) || progressOnly());

        allow delete: if lockable() && canWrite(hid) && canEdit()
          && (!isDevice(hid) || (deviceKitchen() && collection != 'products'));
      }
    }
  }
}
