rules_version = '2';

// Model i decyzje: docs/ROADMAP.md → „Decyzje” i „Model danych”.
// Testy: npm run test:rules (emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberPath(hid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid);
    }

    // Administrator ogólny — jedno konto, admin każdego mieszkania (także
    // przed dołączeniem, np. migracja pierwszego mieszkania). Zmiana adresu
    // także w src/lib/householdSetup.ts (SUPER_ADMIN_EMAIL).
    function isSuperAdmin() {
      return hasAccount()
        && request.auth.token.email == 'stasiron9102@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // isSuperAdmin() najpierw — lista mieszkań (query) przechodzi bez exists()
    function isMember(hid) {
      return signedIn() && (isSuperAdmin() || exists(memberPath(hid)));
    }

    function isAdmin(hid) {
      return signedIn()
        && (isSuperAdmin()
          || (exists(memberPath(hid)) && get(memberPath(hid)).data.role == 'admin'));
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // OKRES PRZEJŚCIOWY — usuń po dołączeniu całej rodziny kodem.
    // Stara wersja aplikacji (main sprzed multi-mieszkań) czyta cały stan domu
    // z households/homeharmony — do czasu przesiadki rodziny każdy zalogowany
    // może go czytać. Zapisywać już nie: stary sync wysyła cały dokument przy
    // każdej zmianie i dwie otwarte karty potrafią odbijać zapisy w kółko
    // (2026-11-04: ~12k zapisów/h, limit Spark wyczerpany). Zmiany i tak
    // przepadłyby po migracji.
    function legacyTransition(hid) {
      return hid == 'homeharmony' && signedIn();
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /memberships/{hid} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Urządzenia z włączonymi powiadomieniami (Web Push) — tylko właściciel;
      // serwer czyta je kontem serwisowym
      match /pushSubscriptions/{subId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      // Prywatna lodówka, instrukcje… — tylko z kontem (decyzja 1)
      match /private/{document=**} {
        allow read, write: if hasAccount() && request.auth.uid == userId;
      }
    }

    // Zgłoszenia błędów — wysyła każdy zalogowany (także tablet), czyta
    // i obsługuje tylko administrator ogólny
    match /bugReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 4000
        && request.resource.data.keys().hasOnly([
          'description', 'status', 'createdAt', 'uid', 'email', 'anonymous',
          'householdId', 'householdName', 'role', 'path', 'search', 'tab',
          'selector', 'elementText', 'heading', 'x', 'y', 'viewport',
          'scrollY', 'appVersion', 'appCommit', 'userAgent'
        ]);
      allow read, update, delete: if isSuperAdmin();
    }

    // Ustawienia całej aplikacji (src/lib/globalConfig.ts)
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    match /invites/{code} {
      // get po znanym kodzie tak, list nie — kodów nie da się wyliczyć
      allow get: if signedIn();
      allow create: if isAdmin(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAdmin(resource.data.householdId);
    }

    match /households/{hid} {
      allow read: if isMember(hid) || legacyTransition(hid);
      allow create: if hasAccount()
        && request.resource.data.ownerId == request.auth.uid;
      // PANIC (goście) włącza każdy domownik — tylko to jedno pole
      // ownerId (twórca) zmienia tylko administrator ogólny
      allow update: if (isAdmin(hid)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
            || isSuperAdmin()))
        || (isMember(hid) && changedOnly(['panic']));
      allow delete: if isAdmin(hid);

      match /members/{uid} {
        allow read: if isMember(hid);

        // Nowy wpis: tylko znane pola, a dane konta zgodne z tokenem —
        // nikt nie dołączy z cudzym e-mailem (admin łączy konta po nim)
        function newMemberOk() {
          let data = request.resource.data;
          return data.keys().hasOnly([
              'uid', 'role', 'profileId', 'anonymous', 'displayName', 'email',
              'provider', 'joinedAt', 'inviteCode'
            ])
            && (!('email' in data) || data.email == null
              || data.email == request.auth.token.get('email', null))
            && (!('anonymous' in data)
              || data.anonymous == (request.auth.token.firebase.sign_in_provider == 'anonymous'));
        }

        // Konto z e-mailem dołącza kodem dopiero po potwierdzeniu adresu.
        // Urządzenie bez konta (np. wspólny tablet) — bez zmian.
        function verifiedOrDevice() {
          return request.auth.token.firebase.sign_in_provider == 'anonymous'
            || request.auth.token.get('email_verified', false) == true;
        }

        allow create: if signedIn() && request.auth.uid == uid && newMemberOk() && (
          // Twórca mieszkania — w tym samym batchu co dokument mieszkania
          (request.resource.data.role == 'admin'
            && getAfter(householdPath(hid)).data.ownerId == request.auth.uid)
          // Administrator ogólny dopisuje się do dowolnego mieszkania
          || (request.resource.data.role == 'admin' && isSuperAdmin())
          // Dołączenie kodem zaproszenia
          || (request.resource.data.role == 'member'
            && verifiedOrDevice()
            && request.resource.data.inviteCode is string
            && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == hid)
        );

        // Własny wpis: profil + dane konta, ale tylko zgodne z tokenem —
        // nikt nie wpisze sobie cudzego e-maila (admin łączy konta po nim)
        function memberChanged() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        function tokenProvider() {
          return request.auth.token.firebase.sign_in_provider;
        }

        // Link z maila: token mówi „emailLink”, a konto (providerData) —
        // „password”. Oba to to samo konto e-mail.
        function providerMatches(provider) {
          return provider == tokenProvider()
            || (provider == 'password' && tokenProvider() == 'emailLink');
        }

        function selfUpdateOk() {
          return memberChanged().hasOnly([
              'profileId', 'displayName', 'email', 'anonymous', 'provider'
            ])
            && (!memberChanged().hasAny(['email'])
              || request.resource.data.email == request.auth.token.get('email', null))
            && (!memberChanged().hasAny(['anonymous'])
              || request.resource.data.anonymous == (tokenProvider() == 'anonymous'))
            && (!memberChanged().hasAny(['provider'])
              || providerMatches(request.resource.data.provider));
        }

        function householdOwner() {
          return get(householdPath(hid)).data.ownerId;
        }

        // Role nadaje tylko twórca mieszkania albo administrator ogólny
        function canManageRoles() {
          return isSuperAdmin() || householdOwner() == request.auth.uid;
        }

        // Twórcy nie odbierze roli ani nie usunie inny administrator
        function touchesOwner() {
          return uid == householdOwner()
            && request.auth.uid != uid
            && !isSuperAdmin();
        }

        allow update: if (isAdmin(hid)
            && (!memberChanged().hasAny(['role']) || canManageRoles())
            && !touchesOwner())
          || (signedIn() && request.auth.uid == uid && selfUpdateOk());

        // Admin usuwa (poza twórcą), każdy może wyjść sam
        allow delete: if (isAdmin(hid) && !touchesOwner())
          || (signedIn() && request.auth.uid == uid);
      }

      // Domownicy (też bez konta) — lista osób mieszkania
      match /profiles/{profileId} {
        allow read: if isMember(hid);
        allow create, delete: if isAdmin(hid);
        allow update: if isAdmin(hid)
          || (isMember(hid) && changedOnly(['heavyDay']));
      }

      match /assets/{assetId} {
        allow read: if isMember(hid);
        allow write: if isAdmin(hid);
      }

      // Historia wykonań (statystyki) — tylko dopisywana: wpis dodaje każdy
      // domownik (także tablet), zmienić się go nie da, usuwa administrator
      match /completions/{completionId} {
        allow read: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.createdBy == request.auth.uid;
        allow delete: if isAdmin(hid);
      }

      // Prywatne obowiązki / zadania / todo / zakupy / lodówka / poradnik —
      // tylko autor (z kontem). Nawet administrator ogólny ich nie widzi.
      match /private/{ownerUid}/{collection}/{itemId} {
        allow read, write: if hasAccount()
          && request.auth.uid == ownerUid
          && collection in [
            'chores', 'zadania', 'todos', 'shopping', 'fridge', 'guides',
            'guideEntries', 'products', 'laundry'
          ]
          && exists(memberPath(hid));
      }

      // Przepisy — zawsze czyjeś (konto). Widzi autor, wszyscy domownicy
      // przy share == 'all' albo konta z mapy sharedWith. Zmienia tylko autor.
      match /recipes/{recipeId} {
        function recipeOwner() {
          return hasAccount() && resource.data.createdBy == request.auth.uid;
        }

        function validShare() {
          return request.resource.data.share in ['private', 'all', 'people']
            && request.resource.data.sharedWith is map
            && (request.resource.data.share == 'people'
              || request.resource.data.sharedWith.size() == 0);
        }

        allow read: if isMember(hid) && (
          resource.data.share == 'all'
          || (signedIn() && resource.data.createdBy == request.auth.uid)
          || (signedIn()
            && resource.data.sharedWith.get(request.auth.uid, false) == true)
        );

        allow create: if hasAccount() && exists(memberPath(hid))
          && request.resource.data.createdBy == request.auth.uid
          && validShare();

        allow update: if recipeOwner() && exists(memberPath(hid))
          && request.resource.data.createdBy == request.auth.uid
          && validShare();

        allow delete: if recipeOwner();
      }

      // Elementy z przyciskiem „Zablokuj edycję” (decyzja 3a)
      match /{collection}/{itemId} {
        function lockable() {
          return collection in [
            'chores', 'zadania', 'todos', 'todoFolders',
            'shopping', 'laundry', 'guestPlans', 'fridge', 'guides',
            'guideTabs', 'guideEntries', 'bills', 'purchases', 'products',
            'announcements', 'absences'
          ];
        }

        function isCreator() {
          return resource.data.createdBy == request.auth.uid;
        }

        function wasLocked() {
          return resource.data.get('locked', false) == true;
        }

        function willBeLocked() {
          return request.resource.data.get('locked', false) == true;
        }

        function canEdit() {
          return !wasLocked() || isCreator() || isAdmin(hid);
        }

        // Odhaczanie zablokowanego elementu — każdy domownik
        function progressOnly() {
          // rotationTurn — „na zmianę”: odhaczenie przesuwa turę
          // amount — zużycie z lodówki po ugotowaniu przepisu
          // settled, refundRequestedAt — rozliczenia rachunków i wspólnych zakupów
          // stock, stockAmount, lastBoughtAt — zużycie i uzupełnienie zapasów
          return changedOnly([
            'lastCompleted', 'lastCompletedBy', 'done', 'completedBy', 'checked',
            'rotationTurn', 'amount', 'settled', 'stock', 'stockAmount',
            'lastBoughtAt', 'refundRequestedAt', 'issueStatus', 'confirmed'
          ]);
        }

        function lockChangeAllowed() {
          return wasLocked() == willBeLocked()
            || (hasAccount() && (isCreator() || isAdmin(hid)));
        }

        allow read: if lockable() && isMember(hid);

        allow create: if lockable() && isMember(hid)
          && request.resource.data.createdBy == request.auth.uid
          && (!willBeLocked() || hasAccount());

        allow update: if lockable() && isMember(hid)
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && lockChangeAllowed()
          && (canEdit() || progressOnly());

        allow delete: if lockable() && isMember(hid) && canEdit();
      }
    }
  }
}
